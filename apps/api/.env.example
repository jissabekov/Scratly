# Use localhost when the API runs directly on your workstation.
DATABASE_URL=postgresql+asyncpg://scratly:scratly_local_only@localhost:5432/scratly

# Optional for tests that invoke Azure OpenAI; unit/DB/health tests do not need it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_ANALYZER_DEPLOYMENT=analyzer
AZURE_OPENAI_WRITER_DEPLOYMENT=writer
AZURE_OPENAI_SUMMARY_DEPLOYMENT=summary

MEMORY_RESPONSE_INTERVAL=8
MEMORY_TOKEN_THRESHOLD=6000
REDUCER_VERSION=v1
