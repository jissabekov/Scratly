# Host-run API only (make api-run / uvicorn). Copy to apps/api/.env.
# Inside Docker Compose, DATABASE_URL is injected and points at host `postgres`.

# Host → published Compose Postgres (see root .env POSTGRES_*).
DATABASE_URL=postgresql+asyncpg://scratly:scratly_local_only@localhost:5432/scratly

# Azure OpenAI via Entra (DefaultAzureCredential). Leave endpoint empty to run
# without LLM calls (question writer uses seeded fallback templates).
# Example: https://pcoding.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://pcoding.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_ANALYZER_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_WRITER_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_SUMMARY_DEPLOYMENT=gpt-5.4-mini

# Optional Entra service principal (otherwise use `az login` on the host).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

MEMORY_RESPONSE_INTERVAL=8
MEMORY_TOKEN_THRESHOLD=6000
REDUCER_VERSION=v1
