# =============================================================================
# Scratly local Docker Compose (.env). Copy to `.env` at the repo root.
# Disposable development values only — do not reuse outside a workstation.
# =============================================================================

# --- PostgreSQL (compose service: postgres) ---------------------------------
POSTGRES_DB=scratly
POSTGRES_USER=scratly
POSTGRES_PASSWORD=scratly_local_only
# Host publish: postgresql://scratly:scratly_local_only@127.0.0.1:5432/scratly
POSTGRES_PORT=5432

# --- Published application ports (bound to 127.0.0.1) -----------------------
# API:  http://127.0.0.1:8000  (OpenAPI /docs, /health, /health/ready)
# Web:  http://127.0.0.1:3000
API_PORT=8000
WEB_PORT=3000

# --- Azure OpenAI (Entra via DefaultAzureCredential; required for live LLM) -
# Cognitive Services / Azure OpenAI endpoint (trailing slash optional).
# Example: https://pcoding.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://pcoding.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Single shared deployment is fine for local testing.
AZURE_OPENAI_ANALYZER_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_WRITER_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_SUMMARY_DEPLOYMENT=gpt-5.4-mini

# Service principal for the API *container* (DefaultAzureCredential chain).
# Host-run API should use `az login` instead; leave these blank on the host.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- API tuning (passed into the api service when using --profile full) -----
MEMORY_RESPONSE_INTERVAL=8
MEMORY_TOKEN_THRESHOLD=6000
REDUCER_VERSION=v1

# --- Not used locally (intentionally absent / gated) ------------------------
# No Redis, message bus, Cosmos DB, or search service.
# Azure Blob Storage and Application Insights are production-only sketches in
# infra/bicep — not required for local compose or the assessment journey.
