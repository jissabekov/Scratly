# Local PostgreSQL container. These values are for disposable development only.
POSTGRES_DB=scratly
POSTGRES_USER=scratly
POSTGRES_PASSWORD=scratly_local_only
POSTGRES_PORT=5432

# API published port and web published port.
API_PORT=8000
WEB_PORT=3000

# Optional Azure OpenAI integration. Leave blank for DB/unit/UI-only testing.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_ANALYZER_DEPLOYMENT=analyzer
AZURE_OPENAI_WRITER_DEPLOYMENT=writer
AZURE_OPENAI_SUMMARY_DEPLOYMENT=summary
